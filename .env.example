# Copy to .env and fill in. Never commit the real file.

# --- required in production ---
BREAKAPI_ENV=production
# The https:// address users reach the app on (used for cookies and emailed links).
BREAKAPI_PUBLIC_URL=https://breakapi.example.com
# 32 random bytes, base64. Generate with: openssl rand -base64 32   (or: node src/cli.js gen-key)
# Encrypts stored test credentials. Losing it makes stored credentials unreadable; changing it does too.
BREAKAPI_SECRET_KEY=
# Outbound email for password reset and authorizer confirmations.
SMTP_HOST=smtp.example.com
SMTP_PORT=465            # 465 = implicit TLS, 587 = STARTTLS
SMTP_USER=
SMTP_PASS=
BREAKAPI_MAIL_FROM=breakAPI <no-reply@example.com>

# --- behind a reverse proxy (recommended) ---
# Trust X-Forwarded-For / X-Forwarded-Proto from the proxy. Only enable when the app is NOT reachable directly.
BREAKAPI_TRUST_PROXY=true

# --- policy (production defaults shown) ---
BREAKAPI_LAB=true                     # the public demo lab: fixed examples against a built-in practice API on loopback
BREAKAPI_LAB_DAILY_RUNS=300           # most lab runs (examples, playground runs, retests) started per UTC day

# --- lab playground: the simulation backend (separate repo, breakapi-sim) ---
# Set both or neither. The URL is the sim's bare https:// origin; the key must equal its SIM_CONTROL_KEY.
BREAKAPI_SIM_URL=
BREAKAPI_SIM_CONTROL_KEY=
# Both default to false whenever the server is hosted (production, an https public URL, or Replit).
BREAKAPI_ALLOW_LOCAL_TARGETS=false    # true lets users scan this server itself (localhost). Keep false when hosted.
BREAKAPI_ALLOW_PRIVATE_TARGETS=false  # true lets users scan 10.x / 172.16-31.x / 192.168.x addresses reachable from the server.
BREAKAPI_MAX_CONCURRENT_SCANS=4
BREAKAPI_SESSION_HOURS=12             # admin idle timeout; admin sessions also end 7 days after sign-in. Issued accounts last until their access ends.

# --- process ---
PORT=7300
BREAKAPI_DATA=/data
